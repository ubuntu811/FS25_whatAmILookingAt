<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<GUI onOpen="onOpen" onClose="onClose">
    <Bitmap profile="fs25_fullScreenBackground"/>

    <!-- Left column: topics (registered debug tabs), same base-game
         "hotspot filter" shape as the in-game map's own Hotspots menu
         (VEHICLES/COMBINES/TRAILERS/... list on the left, content on the
         right); unmodified fs25_subCategoryContainer defaults, exactly
         what already rendered correctly, just re-pointed at topics
         instead of items. Scales to any number of registered tabs via
         its own scrollbar; no fixed slot count, no button-row crowding. -->
    <GuiElement profile="fs25_subCategoryContainer" height="950px">
        <Bitmap profile="fs25_subCategoryStartClipper" name="topicStartClipper"/>
        <Bitmap profile="fs25_subCategoryStopClipper" name="topicEndClipper"/>
        <SmoothList profile="fs25_subCategoryList" id="topicList" startClipperElementName="topicStartClipper" endClipperElementName="topicEndClipper">
            <ListItem profile="fs25_subCategoryListItem">
                <Bitmap profile="waila_hubTopicIcon" name="icon"/>
                <Text profile="waila_hubTopicLabel" name="label"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="topicList"/>
        </ThreePartBitmap>
    </GuiElement>

    <!-- Right column: the selected topic's items; position/size lifted
         directly from FS25_MapObjectsHider's own right-hand panel
         (fs25_mohMapBox/fs25_mohCamBox in its mapObjectsHiderDialog.xml, a
         real installed mod, not guessed), same emptyPanel +
         anchorStretchingYLeft technique, same 450px x-offset (matches
         where the topic list column ends). Same list/clipper/slider
         pieces as the topic list, just nested in this panel instead;
         wider than the old single narrow column, so labels like "Dump
         inspected target" have more room before truncating. -->
    <GuiElement profile="waila_hubDetailBox">
        <Bitmap profile="fs25_subCategoryStartClipper" name="itemStartClipper"/>
        <Bitmap profile="fs25_subCategoryStopClipper" name="itemEndClipper"/>
        <SmoothList profile="fs25_subCategoryList" id="itemList" startClipperElementName="itemStartClipper" endClipperElementName="itemEndClipper">
            <!-- Flat background (waila_hubFlatListItem), not
                 fs25_subCategoryListItem: that profile's dark icon-box
                 cap is baked into the gui.animalDealer_box atlas image
                 itself, not adjustable via a size/position override, and
                 with no icon here (unlike the topic list) it just reads as
                 a big empty black block in this wider column. -->
            <ListItem profile="waila_hubFlatListItem">
                <Text profile="waila_hubItemPrimary" name="primary"/>
                <Text profile="waila_hubItemSecondary" name="secondary"/>
            </ListItem>
        </SmoothList>
        <ThreePartBitmap profile="fs25_subCategoryListSliderBox">
            <Slider profile="fs25_listSlider" dataElementId="itemList"/>
        </ThreePartBitmap>
    </GuiElement>

    <!-- Third column: the selected item's actions (tab.buttons); FIXED
         BUTTON SLOTS, not a SmoothList. Confirmed live (real, repeated,
         multi-test evidence): a SmoothList conflates "select" (move the
         highlight) with "activate", and a genuine click on a
         non-default row kept running whatever was PREVIOUSLY selected
         instead of the clicked one; a real engine-level ambiguity in
         click-vs-select semantics, not something fixable from this side
         reliably. A plain Button's onClick has been rock solid all
         session (Back, every earlier footer button) with none of that
         ambiguity, and this list is always small/bounded (typically
         1-4 actions per tab) unlike the genuinely open-ended topic
         list, so a fixed-slot approach (same idea as the old footer,
         just more headroom) is the right tool here, not a limitation.
         Anchored from the RIGHT edge, same dual-panel technique
         FS25_MapObjectsHider uses for its own two side-by-side preview
         boxes. -->
    <GuiElement profile="waila_hubActionsBox">
        <Button profile="waila_hubActionButton" position="0px -20px" id="actionButton1" onClick="onClickAction1" text=""/>
        <Button profile="waila_hubActionButton" position="0px -160px" id="actionButton2" onClick="onClickAction2" text=""/>
        <Button profile="waila_hubActionButton" position="0px -300px" id="actionButton3" onClick="onClickAction3" text=""/>
        <Button profile="waila_hubActionButton" position="0px -440px" id="actionButton4" onClick="onClickAction4" text=""/>
        <Button profile="waila_hubActionButton" position="0px -580px" id="actionButton5" onClick="onClickAction5" text=""/>
        <Button profile="waila_hubActionButton" position="0px -720px" id="actionButton6" onClick="onClickAction6" text=""/>
    </GuiElement>

    <BoxLayout profile="fs25_buttonBox" id="buttonsPanel">
        <Button profile="buttonBack" onClick="onClickClose" text="$l10n_button_back"/>
    </BoxLayout>

    <GUIProfiles>
        <!-- fs25_subCategoryListItemIcon is the real base-game icon-slot
             profile for this exact row skin (guiProfiles.xml); default
             size/position (anchorMiddleLeft, 66x65, 11px 8px) already
             fits the dark icon-slot area of the shared list-item
             background, no override needed. imageFilename set per-row
             in Lua via BitmapElement:setImageFilename. -->
        <Profile name="waila_hubTopicIcon" extends="fs25_subCategoryListItemIcon"/>
        <Profile name="waila_hubTopicLabel" extends="fs25_textDarkHighlight" with="anchorBottomLeft">
            <position value="100px 60px"/>
            <textSize value="26px"/>
            <textVerticalAlignment value="bottom"/>
            <textColor value="$preset_fs25_colorMainHighlight"/>
            <textFocusedColor value="$preset_fs25_colorMainLight"/>
            <textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <!-- Plain flat fill, not the shop-style gui.animalDealer_box skin;
             gui.colorPreset is a genuinely uniform-color slice (used
             all over guiProfiles.xml for buttons/separators/plain boxes).
             Selected fill uses the same bright green as everywhere else
             selection shows in this dialog (fs25_colorMainHighlight,
             matching the topic list's still-default gui.animalDealer_box
             skin) rather than colorItemBgSelected (dark); the text
             profiles here extend fs25_textDarkHighlight, which already
             defines a DARK textSelectedColor by design, meant to pair
             with a bright selected background; a dark selected fill was
             dark-text-on-dark-background. -->
        <Profile name="waila_hubFlatListItem" extends="baseReference" with="anchorTopStretchingX">
            <height value="140px"/>
            <imageSliceId value="gui.colorPreset"/>
            <imageColor value="$preset_colorItemBgNormal"/>
            <imageSelectedSliceId value="gui.colorPreset"/>
            <imageSelectedColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <!-- textMaxNumLines="2" (wrap) plus a PERCENTAGE size together
             reproduced a real stack overflow inside the engine's own
             TextElement code on a clean load. Staying in single-line
             truncate mode (no textMaxNumLines) here, but there's plenty
             of unused row width, so just widening the text with a fixed
             pixel size lets most labels fit on one line without
             truncating at all; no wrap, so none of the crash-prone
             code path is touched. -->
        <Profile name="waila_hubItemPrimary" extends="fs25_textDarkHighlight" with="anchorBottomLeft">
            <position value="30px 60px"/>
            <size value="700px 60px"/>
            <textSize value="26px"/>
            <textVerticalAlignment value="bottom"/>
            <textColor value="$preset_fs25_colorMainHighlight"/>
            <textFocusedColor value="$preset_fs25_colorMainLight"/>
            <textHighlightedColor value="$preset_fs25_colorMainHighlight"/>
        </Profile>
        <Profile name="waila_hubItemSecondary" extends="fs25_textDarkHighlight" with="anchorBottomRight">
            <position value="-38px 30px"/>
            <textAlignment value="right"/>
        </Profile>
        <Profile name="waila_hubDetailBox" extends="emptyPanel" with="anchorStretchingYLeft">
            <size value="45% 950px"/>
            <position value="450px 0px"/>
        </Profile>
        <Profile name="waila_hubActionsBox" extends="emptyPanel" with="anchorStretchingYRight">
            <size value="20% 950px"/>
            <position value="-30px 0px"/>
        </Profile>
        <!-- Extends fs25_wideButton directly, NOT buttonOK; confirmed
             via decompiled ButtonElement.lua + guiProfiles.xml: buttonOK
             bakes in inputAction="MENU_ACCEPT" on its OWN definition
             (not inherited from fs25_wideButton), which registers a real
             input-binding event in ButtonElement:onOpen(). Every button
             using that profile independently subscribes to the SAME
             shared Enter/confirm action; with multiple actionButtons
             visible at once, pressing Enter fired ALL of them
             simultaneously (confirmed live: "2 buttons executed from one
             press", not a focus-sync issue at all; handleFocus only
             governs mouse-hover highlight state, unrelated to this).
             fs25_wideButton gives the same visual style with no
             inputAction at all, so these are mouse-click-only by
             construction, not by trying to suppress an inherited one. -->
        <Profile name="waila_hubActionButton" extends="fs25_wideButton" with="anchorTopLeft">
            <size value="90% 120px"/>
        </Profile>
    </GUIProfiles>
</GUI>
